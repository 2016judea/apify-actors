{
  "layer": "https://services.arcgis.com/afSMGVsC7QlRK1kZ/arcgis/rest/services/Active_Rental_Licenses/FeatureServer/0",
  "order": "licensedUnits DESC",
  "filters": [
    {
      "input": "ownerName",
      "field": "ownerName",
      "op": "like"
    },
    {
      "input": "neighborhood",
      "field": "neighborhoodDesc",
      "op": "ieq"
    },
    {
      "input": "minUnits",
      "field": "licensedUnits",
      "op": "gte"
    },
    {
      "input": "shortTermRentalOnly",
      "field": "shortTermRental = 'Yes'",
      "op": "bool"
    }
  ],
  "drop": [
    "OBJECTID",
    "xWebMercator",
    "yWebMercator",
    "ownerPhone",
    "ownerEmail",
    "applicantPhone",
    "applicantEmail"
  ],
  "static": {
    "source": "City of Minneapolis Open Data (opendata.minneapolismn.gov)"
  }
}
