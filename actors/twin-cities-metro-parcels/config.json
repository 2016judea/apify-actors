{
  "layer": "https://arcgis.metc.state.mn.us/data1/rest/services/parcels/Parcels/FeatureServer/4",
  "layerByInput": [
    "county",
    {
      "Anoka": "https://arcgis.metc.state.mn.us/data1/rest/services/parcels/Parcels/FeatureServer/0",
      "Carver": "https://arcgis.metc.state.mn.us/data1/rest/services/parcels/Parcels/FeatureServer/1",
      "Dakota": "https://arcgis.metc.state.mn.us/data1/rest/services/parcels/Parcels/FeatureServer/2",
      "Hennepin": "https://arcgis.metc.state.mn.us/data1/rest/services/parcels/Parcels/FeatureServer/3",
      "Ramsey": "https://arcgis.metc.state.mn.us/data1/rest/services/parcels/Parcels/FeatureServer/4",
      "Scott": "https://arcgis.metc.state.mn.us/data1/rest/services/parcels/Parcels/FeatureServer/5",
      "Washington": "https://arcgis.metc.state.mn.us/data1/rest/services/parcels/Parcels/FeatureServer/6"
    }
  ],
  "order": "EMV_TOTAL DESC",
  "filters": [
    {
      "input": "city",
      "field": "CTU_NAME",
      "op": "ieq"
    },
    {
      "input": "street",
      "field": "ST_NAME",
      "op": "like"
    },
    {
      "input": "zip",
      "field": "ZIP",
      "op": "eq"
    },
    {
      "input": "builtBefore",
      "field": "YEAR_BUILT",
      "op": "lte"
    },
    {
      "input": "minValue",
      "field": "EMV_TOTAL",
      "op": "gte"
    },
    {
      "input": "ownerName",
      "field": "OWNER_NAME",
      "op": "like"
    }
  ],
  "drop": [
    "OBJECTID",
    "Shape__Area",
    "Shape__Length",
    "POLYPTREL",
    "N_STANDARD"
  ],
  "static": {
    "source": "Metropolitan Council regional parcel dataset (MetroGIS)"
  }
}
