  "outFields": "PID,PID_TEXT,HOUSE_NO,FRAC_HOUSE_NO,STREET_NM,CONDO_NO,ZIP_CD,MUNIC_NM,OWNER_NM,TAXPAYER_NM,TAXPAYER_NM_1,TAXPAYER_NM_2,TAXPAYER_NM_3,BUILD_YR,SALE_DATE,SALE_PRICE,SALE_CODE_NAME,PARCEL_AREA,MKT_VAL_TOT,TAXABLE_VAL_TOT,TAX_TOT,NET_TAX_PD,EARLIEST_DELQ_YR,PR_TYP_NM1,HMSTD_CD1,LAND_MV1,BLDG_MV1,TOTAL_MV1,SCHOOL_DIST_NO,ABBREV_ADDN_NM,LOT,BLOCK,LAT,LON",
